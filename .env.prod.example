# Copy to .env (never commit .env itself -- it will contain real passwords), alongside
# docker-compose.prod.yml. docker compose automatically reads a .env file in the same
# directory for variable substitution.

# Required, replace with a real strong password -- don't reuse the local-dev "tradeforge".
TF_PG_PASSWORD=

# Required, the server-side master key -- encrypts every user's exchange/LLM credentials.
# This is not anyone's login password (login is email+password self-signup now, see
# /signup). At least a 32-character strong random string, e.g.:
#   openssl rand -base64 32
# Losing it permanently locks everyone out of their stored credentials -- back it up
# separately, don't let it live only in this .env file.
TF_MASTER_KEY=

# Optional: the LLM translation layer's key (Anthropic). Leave it unset and the
# wizard/batch-scan pages are unavailable; everything else is unaffected. You can also
# leave it unset here and configure it via the /settings page after signing up/logging in
# (supports DeepSeek and other providers, encrypted at rest, no need to come back and edit
# this file).
ANTHROPIC_API_KEY=

# Required, which user the executor / signal-engine containers serve -- must be the email
# of a real account already registered via /signup. After the multi-tenant SaaS rework
# these two services still each serve exactly one user per process (see the doc comment in
# cmd/executor/main.go) -- getting multiple users' strategies to run automatically means
# starting a separate executor/signal-engine container pair per user, a known limitation of
# the current stage.
TF_OWNER_EMAIL=

# Optional: which order-placement channel cmd/executor uses. Defaults to paper (a pure
# in-memory simulator, doesn't touch any real exchange -- the safest option). To actually
# connect to an exchange, switch to one of okx-demo / binance-testnet / bybit-testnet /
# bitget-demo -- don't put credentials here, configure them on the /settings page's
# "exchange order-placement channel" section (after logging into the account that matches
# TF_OWNER_EMAIL).
EXECUTOR_BROKER=paper

# Optional: shared by executor and signal-engine -- which state of strategy to process.
EXECUTOR_STATE=PAPER_TRADING
