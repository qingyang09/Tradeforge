# 复制成 .env（不要提交 .env 本身——它会包含真实密码），跟 docker-compose.prod.yml
# 放在同一目录。docker compose 会自动读取同目录下的 .env 文件做变量替换。

# 必填，换成真实强密码，不要用本地开发时的 "tradeforge"。
TF_PG_PASSWORD=

# 必填，服务端主密钥——加密所有用户的交易所/LLM 凭据用的，不是任何人的登录密码
# （登录改成邮箱+密码自注册了，见 /signup）。至少 32 位强随机字符串，例如：
#   openssl rand -base64 32
# 丢失它等于永久锁死全部用户已存的凭据，务必单独备份，不要只存在这份 .env 里。
TF_MASTER_KEY=

# 可选：LLM 翻译层的 key（Anthropic）。不填的话向导/批量扫描页面不可用，其余功能不受
# 影响；也可以先不填，注册/登录后去 /settings 页面配置（支持 DeepSeek 等更多供应商，
# 加密存库，不用再回来改这个文件）。
ANTHROPIC_API_KEY=

# 必填，executor / signal-engine 这两个容器服务哪个用户——必须是一个已经在 /signup
# 注册过的真实账号邮箱。多用户 SaaS 改造后这两个服务仍是"一个进程只服务一个用户"
# （见 cmd/executor/main.go 文档注释），要让多个用户的策略都自动跑起来，需要为每个
# 用户各起一组 executor/signal-engine 容器，这是当前阶段的已知限制。
TF_OWNER_EMAIL=

# 可选：cmd/executor 用哪个下单通道。默认 paper（纯内存模拟盘，不接任何交易所，最安全）。
# 真要接交易所时改成 okx-demo / binance-testnet / bybit-testnet / bitget-demo 之一——
# 凭据本身不要写在这里，去 /settings 页面的"交易所下单通道"配置（登录 TF_OWNER_EMAIL
# 对应的那个账号后再配）。
EXECUTOR_BROKER=paper

# 可选：executor 和 signal-engine 共用，处理哪个状态的策略。
EXECUTOR_STATE=PAPER_TRADING
