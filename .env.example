# 复制为 .env 后按需修改。默认值对应 docker-compose 起的本地服务。

# Postgres（宿主机端口避开默认 5432，本机已有其它 Postgres 实例）
TF_PG_HOST=localhost
TF_PG_PORT=55432
TF_PG_USER=tradeforge
TF_PG_PASSWORD=tradeforge
TF_PG_DATABASE=tradeforge
TF_PG_SSLMODE=disable

# Redis
TF_REDIS_ADDR=localhost:56379
TF_REDIS_PASSWORD=
TF_REDIS_DB=0

# Kafka
TF_KAFKA_BROKERS=localhost:59200
TF_KAFKA_DECISION_TOPIC=tradeforge.decisions
TF_KAFKA_SIGNAL_TOPIC=tradeforge.signals

# AI Agent 翻译层。留空则 Agent 只能以离线桩模式运行（测试用）。
ANTHROPIC_API_KEY=
TF_AGENT_MODEL=claude-opus-5
TF_AGENT_TIMEOUT=60s
TF_AGENT_MAX_RETRIES=2

# 组合引擎：单模块超时后降级为中性信号
TF_MODULE_TIMEOUT=3s

# Web 界面（cmd/webui）
TF_HTTP_ADDR=:8080
