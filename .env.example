# Copy to .env and adjust as needed. Defaults match the local services started by
# docker-compose.

# Postgres (host port offset from the default 5432 -- this machine already runs another
# Postgres instance)
TF_PG_HOST=localhost
TF_PG_PORT=55432
TF_PG_USER=tradeforge
TF_PG_PASSWORD=tradeforge
TF_PG_DATABASE=tradeforge
TF_PG_SSLMODE=disable

# Redis
TF_REDIS_ADDR=localhost:56379
TF_REDIS_PASSWORD=
TF_REDIS_DB=0

# Kafka
TF_KAFKA_BROKERS=localhost:59200
TF_KAFKA_DECISION_TOPIC=tradeforge.decisions
TF_KAFKA_SIGNAL_TOPIC=tradeforge.signals

# AI Agent translation layer. Leave empty and the Agent can only run in offline stub mode
# (for testing).
ANTHROPIC_API_KEY=
TF_AGENT_MODEL=claude-opus-5
TF_AGENT_TIMEOUT=60s
TF_AGENT_MAX_RETRIES=2

# Composition engine: a single module degrades to a neutral signal after this timeout
TF_MODULE_TIMEOUT=3s

# Web interface (cmd/webui)
TF_HTTP_ADDR=:8080
