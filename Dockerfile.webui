# cmd/webui has one real dependency the other Go services don't: clicking "run backtest"
# shells out to a Python subprocess (`python -m tradeforge_backtest.cli`, see
# internal/webui/handlers_backtest.go) to run the actual fill-matching engine, which by
# default also writes results straight back to Postgres via psycopg (the CLI call doesn't
# pass --no-save). That's the only reason this has its own Dockerfile instead of sharing
# go.Dockerfile -- the runtime environment is genuinely different, not just to save a file.
#
# The frontend templates (internal/webui/templates) are go:embed'd into the binary, so
# they don't need to be COPY'd into the image separately.
#
# Usage:
#   docker build -f Dockerfile.webui -t tradeforge-webui .

# syntax=docker/dockerfile:1
ARG GO_VERSION=1.26.5
ARG PYTHON_VERSION=3.12

FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/webui ./cmd/webui

FROM python:${PYTHON_VERSION}-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

# python/backtest's core logic has zero dependencies (decimal/csv/json are all stdlib) --
# only the optional "persist to the database" feature needs psycopg. But webui's call path
# doesn't pass --no-save, so it goes through that path by default, which means this has to
# be installed.
RUN pip install --no-cache-dir 'psycopg[binary]>=3.1'

WORKDIR /app
COPY python/backtest ./python/backtest
COPY --from=build /out/webui /usr/local/bin/webui

# webui runs the subprocess with its working directory set to the parent of
# python/backtest (PythonDir defaults to the relative path "python/backtest", see
# internal/config/config.go), keeping the same relative-path relationship as local
# development.
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/webui"]
