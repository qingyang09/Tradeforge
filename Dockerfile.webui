# cmd/webui 比其它 Go 服务多一个真实依赖：点"运行回测"时，它会 shell 出一个 Python
# 子进程（`python -m tradeforge_backtest.cli`，见 internal/webui/handlers_backtest.go）
# 跑真正的撮合引擎，默认还会用 psycopg 直接把结果写回 Postgres（CLI 没传 --no-save）。
# 这是它单独有一份 Dockerfile、不跟 go.Dockerfile 共用的唯一原因——运行时环境真的
# 不同，不是为了省一个文件。
#
# 前端模板（internal/webui/templates）是 go:embed 进二进制的，不需要单独 COPY 进镜像。
#
# 用法：
#   docker build -f Dockerfile.webui -t tradeforge-webui .

# syntax=docker/dockerfile:1
ARG GO_VERSION=1.26.5
ARG PYTHON_VERSION=3.12

FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/webui ./cmd/webui

FROM python:${PYTHON_VERSION}-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

# python/backtest 核心逻辑零依赖（decimal/csv/json 都是标准库），只有"落库"这个可选功能
# 需要 psycopg——但 webui 的调用路径没传 --no-save，默认就会走落库，所以这里必须装。
RUN pip install --no-cache-dir 'psycopg[binary]>=3.1'

WORKDIR /app
COPY python/backtest ./python/backtest
COPY --from=build /out/webui /usr/local/bin/webui

# webui 以 python/backtest 所在目录的上一级为工作目录运行子进程（PythonDir 默认相对路径
# "python/backtest"，见 internal/config/config.go），保持跟本地开发时一致的相对路径关系。
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/webui"]
